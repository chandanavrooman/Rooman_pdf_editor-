# Rooman PDF — environment variables (copy to .env). No real values are committed.

# ── Frontend (Vite) ─────────────────────────────────────────────
# Base URL the browser uses to reach the FastAPI backend. Empty = same origin ("/api", proxied to the backend in dev).
VITE_API_BASE=
# Dev server proxy target for /api (vite.config.ts). Only used by `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8000

# ── Backend (FastAPI) — read from this file (repo root .env) or real environment variables ──
# development | production | test. OpenAPI docs (/docs) are only served when ENV=development.
# In production the server refuses to start unless JWT_SECRET is set to a strong value.
ENV=development
# Secret used to sign login tokens (JWT). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Login token lifetime in minutes (default 1440 = 24h).
TOKEN_EXPIRE_MINUTES=1440
# Allow new accounts to register (true/false).
ALLOW_REGISTRATION=true
# LOCAL TESTING ONLY: skip sign-in; every browser gets a session for one fixed local user (local-test@rooman.local).
# Only honoured with ENV=development; the backend refuses to start if this is true with any other ENV. Never enable on a real server.
LOCAL_TEST_MODE=false
# The only browser origin(s) allowed by CORS; comma-separated. Must match where the frontend is served.
CORS_ORIGINS=http://localhost:5173
# Maximum upload size in megabytes (also enforced on request bodies).
MAX_UPLOAD_MB=50
# Requests per minute per client IP for /api/* (0 = off) and, separately, for /api/auth/* login/register.
RATE_LIMIT=120
AUTH_RATE_LIMIT=20
# Where uploaded/generated files and the SQLite database live (server-generated paths only). Default: backend/storage
STORAGE_DIR=
# Uploaded and generated documents are deleted automatically after this many minutes.
FILE_TTL_MINUTES=60
# How often (seconds) the cleanup task runs.
CLEANUP_INTERVAL_SECONDS=60
# Timeout (seconds) for external programs (Ghostscript, LibreOffice, Tesseract). OCR/LibreOffice use at least 600/240.
EXTERNAL_TIMEOUT_SECONDS=180
# Optional explicit paths to external programs (empty = auto-detect on PATH / standard locations).
GS_PATH=
SOFFICE_PATH=
CHROMIUM_PATH=
CHROMIUM_NO_SANDBOX=false
TESSERACT_PATH=

# ── AI assistant (Phase 4) — OpenAI-compatible chat-completions endpoint. The key stays on the server: it is never sent to the
#    browser, never logged and never put in an error message. NOTE: chat/summarize/translate/explain send extracted document TEXT
#    to this endpoint (a third party when you use Groq/OpenAI/...). Leave AI_API_KEY empty to disable the LLM features
#    (text extraction, tables, document comparison and all PDF tools keep working; the API answers AI_KEY_MISSING).
AI_ENDPOINT=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
AI_API_KEY=
# Seconds to wait for the model's next streamed bytes, max tokens per reply, sampling temperature.
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
# AI requests per minute per client IP for /api/ai/* (0 = off). The general RATE_LIMIT also applies.
AI_RATE_LIMIT=30
# Maximum model calls the tool-calling agent may make for one chat request.
AGENT_MAX_ITERATIONS=8
# Seconds a destructive action (delete pages, protect, redact) waits for the user's confirmation before it expires.
PENDING_ACTION_TTL_SECONDS=600

# ── MCP (Phase 5) — rooman-pdf-mcp, the tool server the chat agent uses (Streamable HTTP, path /mcp).
# Shared secret between the backend and the MCP server, >= 32 characters; both read it from this file. The MCP server refuses to
# start without it and rejects every request that lacks `Authorization: Bearer <secret>` plus a signed per-user token.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_SHARED_SECRET=
# Where the backend finds the MCP server, and where the MCP server listens.
MCP_URL=http://localhost:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Lifetime (seconds) of the signed user token the backend mints for each chat request.
MCP_USER_TOKEN_TTL_SECONDS=900
# MCP servers the agent may talk to. Empty = only a loopback MCP_URL (localhost / 127.0.0.1). A server on another host - and any
# external MCP server - is refused unless its exact URL is listed here after an explicit decision. Users' private documents are
# never sent to a server that is not allow-listed.
MCP_ALLOWED_URLS=
